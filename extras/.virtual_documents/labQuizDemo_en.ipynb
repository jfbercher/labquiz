def import_or_install(package_name, pip_name=None):
    import pip
    print(f"Testing {package_name}") 
    try:
        __import__(package_name)
    except ImportError:
        if pip_name is None: pip_name=package_name
        print(f"Installing {pip_name}") 
        pip.main(['install', pip_name])          

