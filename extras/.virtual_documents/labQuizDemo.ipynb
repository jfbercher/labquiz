import labquiz
from labquiz import QuizLab

#URL sans sheetID - Ici on est en mode autonome, pas de connexion internet nécessaire, résultats non sauvegardés
URL = ""
QUIZFILE = "quizzes_basic_filtering_test.yaml"  # Le fichier utilisé dans la doc
quiz = QuizLab(URL, QUIZFILE, needAuthentification=False, retries=99) # pas d'authentificaton, 100 essais permis








quiz.show('quiz1')


quiz.show('quiz5')





quiz.show('quiz59')  #Un quiz à valeur numérique - les réponses sont 0 et 1





# Un test avec des valeurs passées en paramètre ; type "qcm-template"
