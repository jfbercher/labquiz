from labquiz.putils import correctQuizzes

# Commented here because already specified above
#URL = "https://URL_USED_TO_RECORD_RESULTS"
#SECRET = “SECRET_PASSWORD_SPECIFIED_IN_THE_SHEET”
#QUIZFILE = "NAME_OF_QUESTIONS_FILE.yaml" #⚠️ quiz file CONTAINING the expected values
Res = correctQuizzes(URL, SECRET, QUIZFILE, maxtries=3) # ⚠️ Use maxtries, otherwise it uses the first answer
Res





# Construction of the new scale - 1 for the questions answered, zero otherwise
scale1 = {key:1 for key in Res.columns}
scale = {key:0 for key in quiz.quiz_bank.keys() if key not in Res.columns}
scale.update(scale1)
Res = correctQuizzes(URL, SECRET, QUIZFILE, maxtries=3, marking_scheme=scale)
Res




















