








import labquiz
from labquiz import QuizLab
labquiz.set_language('en') # <== Other languages available: ['cn', 'it', 'pt', 'de', 'fr', 'es', 'tr']

#URL without sheetID - Here we are in stand-alone mode, no internet connection required, results not saved
URL = ""
QUIZFILE = "test.yaml"  
quiz = QuizLab(URL, QUIZFILE, needAuthentification=False, retries=99)  # no authentification, 100 attempts allowed






quiz.show('quiz63', autovars=True)








quiz.show('quiz2')


quiz.show('quiz5')





quiz.show('quiz59')  # A quiz with numeric answers - answers are 0 et 1








# A test with values passed as parameters; type "mcq-template"
a = 2
b = 7
quiz.show('quiz53', A=a, B=b)





# A test with values passed as parameters; type "mcq-template"
# autovars=True --> Generate values on the fly
# you can rexecute several time to see that values vary
quiz.show('quiz53', autovars=True)





# A test with values passed as parameters; type "numeric-template"
# and switching to test mode (no correction)
quiz.set_test_mode()
a = 2
b = 11
quiz.show('quiz54', a=a, b=b)


quiz.quiz_correct['quiz54'] = 0 # Restore no correction
quiz.set_test_mode(False)       # test mode off
quiz.show('quiz54', autovars=True)  





quiz.set_exam_mode()
quiz.show('quiz3')


# Reset to normal mode
quiz.set_normal_mode()





quiz.set_normal_mode()
quiz.show('quiz57')











